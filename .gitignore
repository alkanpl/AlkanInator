__pycache__/
*.py[cod]

output/*
!output/.gitkeep

# Katalogi robocze agentow (Codex tworzy outputs/<id-sesji>/ z wynikami, skryptami,
# node_modules i paczkami Pythona). Wzory tytulow/atrybutow, ktore maja zostac,
# ida do configs/title_patterns.yaml, nie tutaj.
outputs/
node_modules/
runtime_deps/
*.inspect.ndjson

reports/*
!reports/.gitkeep

cache/*
!cache/.gitkeep

# Local workspaces, previews and archived source files
.codex_tmp/
.tmp/
tmp/
archived_input_files/

# Local backup copies created during one-off migrations
*.bak
*.bak_*

# Local secrets / API credentials
google-ads.yaml
.env
.env.*
*.token
baselinker-token.txt
/src/baselinker_api/config.json
/src/woo_api/config.json
# Lokalny klient e-katalogu Kontakt-Simon z kluczem API (Program.php)
/Simon API/

# Pliki wejsciowe dostawcow i eksporty sklepu zostaja lokalnie (decyzja 2026-10-29).
